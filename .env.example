# ─── Database ───────────────────────────────────────────────
DB_ROOT_PASSWORD=change-me-to-a-strong-password

# ─── Site ───────────────────────────────────────────────────
# Must match the domain you configure in Coolify (e.g. hr.yourdomain.com)
SITE_NAME=hrms.localhost
ADMIN_PASSWORD=change-me-admin-password

# ─── Ports (Coolify manages routing, but these map host ports) ──
HTTP_PORT=8000
SOCKETIO_PORT=9000

# ─── App Branches (change only if you need a different version) ──
FRAPPE_BRANCH=version-16
ERPNEXT_BRANCH=version-16
PAYMENTS_BRANCH=version-16
