# ─── Database ───────────────────────────────────────────────
DB_ROOT_PASSWORD=change-me-to-a-strong-password

# ─── Site ───────────────────────────────────────────────────
# Must match the domain you use to access the app
SITE_NAME=erp.nordicbh.com
ADMIN_PASSWORD=change-me-admin-password

# Full URL including protocol — used by Frappe for generating links
FRAPPE_HOST_NAME=https://erp.nordicbh.com

# ─── App Branches (change only if you need a different version) ──
FRAPPE_BRANCH=version-16
ERPNEXT_BRANCH=version-16
PAYMENTS_BRANCH=version-16
